# Template para desenvolvimento com um projeto Supabase isolado e dados fictícios.
# VITE_* fica visível no navegador: use somente a chave publicável.
# Nunca use service_role, sb_secret_*, senhas ou segredos em VITE_*.
# A chave publicável não protege tabelas com políticas RLS permissivas.
# Estas variáveis não implementam autenticação para a API local.
SUPABASE_PROJECT_ID="seu-project-id"
SUPABASE_PUBLISHABLE_KEY="sua-chave-publicavel"
SUPABASE_URL="https://seu-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-publicavel"
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"
